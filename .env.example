# 服务监听
PORT=3000
HOST=0.0.0.0
NODE_ENV=production
# 数据文件目录（默认 ./data）
# DATA_DIR=/var/lib/cert-verifier

# 邮件 SMTP 配置（留空则使用控制台模式：验证码打印到日志，便于开发联调）
# 465 隐式 TLS：
SMTP_URL=smtps://你的邮箱:授权密码@smtp.example.com:465
# 587 STARTTLS：
# SMTP_URL=smtp://你的邮箱:授权密码@smtp.example.com:587
# 可在 URL 查询参数中指定发件地址：
# SMTP_URL=smtps://user:pass@smtp.example.com:465?from=noreply@example.com
MAIL_FROM_NAME=培训证书核验平台
MAIL_FROM_EMAIL=noreply@example.com
